{
  "expo": {
    "name": "SubPulse",
    "slug": "subpulse",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#08090A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pnwskyhippy.subpulse",
      "infoPlist": {
        "NSContactsUsageDescription": "SubPulse imports contacts so you can assign payees and split bills."
      }
    },
    "android": {
      "package": "com.pnwskyhippy.subpulse",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08090A"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "READ_CONTACTS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00F59B"
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6551024191049113~2639682721",
          "iosAppId": "ca-app-pub-6551024191049113~5753051363"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "SubPulse imports contacts so you can assign payees and split bills."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "scheme": "subpulse"
  }
}
